# fusion-cache environment variables (copy to .env and fill in)

# --- upstream (choose per provider) --------------------------------------
# OpenAI-compatible (DeepSeek / OpenAI / OpenRouter / local):
FUSION_UPSTREAM_BASE_URL=https://api.deepseek.com
FUSION_UPSTREAM_PROVIDER=openai
# Set ONE of these:
FUSION_UPSTREAM_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Anthropic:
# FUSION_UPSTREAM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- gateway auth ---------------------------------------------------------
# If set, /v1/* requires `Authorization: Bearer <this>`.
FUSION_GATEWAY_API_KEY=

# --- rate limiting --------------------------------------------------------
# Requests per minute per key (0 = disabled).
FUSION_RATE_LIMIT=0
FUSION_RATE_LIMIT_KEY=api_key

# --- CORS -----------------------------------------------------------------
# Comma-separated allowed origins (empty = no CORS).
FUSION_CORS_ORIGINS=

# --- Redis (multi-instance shared cache) ----------------------------------
# Set to enable RedisStore (shared cache across gateway instances).
REDIS_URL=

# --- embedder (L2 semantic layer) -----------------------------------------
# OpenAI-compatible /embeddings endpoint.
FUSION_EMBED_BASE_URL=
FUSION_EMBED_API_KEY=
FUSION_EMBED_MODEL=deepseek-embedding

# --- semantic threshold ----------------------------------------------------
# Raise → fewer (safer) semantic hits; lower → more aggressive.
FUSION_SIM_THRESHOLD=0.93

# --- circuit breaker -------------------------------------------------------
FUSION_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
FUSION_CIRCUIT_BREAKER_COOLDOWN_S=30

# --- upstream retries ------------------------------------------------------
FUSION_UPSTREAM_RETRIES=2
